{
  "description": "pixling-proxy for Codex: what the agent writes, as it goes, on your Pixling resident, permission prompts as questions on it, and what you write there back into the session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" codex session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" codex stop", "timeout": 600 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" codex prompt", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" codex before-tool", "timeout": 10 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" codex permission", "timeout": 90 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" codex session-end", "timeout": 3 }
        ]
      }
    ]
  }
}
