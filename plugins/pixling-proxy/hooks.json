{
  "pixling-proxy": {
    "SessionStart": [
      { "type": "command", "command": "node ./scripts/hook.mjs antigravity session-start", "timeout": 30 }
    ],
    "PreInvocation": [{ "type": "command", "command": "node ./scripts/hook.mjs antigravity prompt", "timeout": 15 }],
    "PostInvocation": [
      { "type": "command", "command": "node ./scripts/hook.mjs antigravity post-invocation", "timeout": 3600 }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hook.mjs antigravity before-tool || printf '{\"decision\":\"ask\"}'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [{ "type": "command", "command": "node ./scripts/hook.mjs antigravity stop", "timeout": 30 }]
  }
}
